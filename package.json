{
  "name": "@open-vibe-lab/open-sub-auth",
  "version": "0.1.1",
  "description": "Open Source Subscription OAuth Authentication Library for AI Providers. Login once with your subscription. Call native APIs directly.",
  "keywords": [
    "ai",
    "authentication",
    "claude",
    "codex",
    "oauth",
    "openai",
    "pkce",
    "subscription",
    "token"
  ],
  "license": "MIT",
  "author": "",
  "bin": {
    "open-sub-auth": "./dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.mts",
        "default": "./dist/core/index.mjs"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/adapters/node/index.d.mts",
        "default": "./dist/adapters/node/index.mjs"
      },
      "require": {
        "types": "./dist/adapters/node/index.d.cts",
        "default": "./dist/adapters/node/index.cjs"
      }
    },
    "./chrome-extension": {
      "import": {
        "types": "./dist/adapters/chrome-extension/index.d.mts",
        "default": "./dist/adapters/chrome-extension/index.mjs"
      },
      "require": {
        "types": "./dist/adapters/chrome-extension/index.d.cts",
        "default": "./dist/adapters/chrome-extension/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "cross-keychain": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.16"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.0"
}
